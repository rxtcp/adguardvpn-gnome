[Unit]
Description=AdGuard VPN Site Routing policy manager
Requires=adguardvpn-site-routing-guard.service
After=adguardvpn-site-routing-guard.service NetworkManager.service dbus.service
Wants=NetworkManager.service

[Service]
Type=dbus
BusName=org.gnome.AdGuardVPN.SiteRouting
ExecStart=/usr/bin/python3 -I -B /usr/libexec/adguardvpn-site-routing/launch.py serve
Restart=on-failure
RestartSec=2
TimeoutStopSec=30
StateDirectory=adguardvpn-site-routing
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_PTRACE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryMax=256M

[Install]
WantedBy=multi-user.target
